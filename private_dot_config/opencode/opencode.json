{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "websearch": "deny",
    "webfetch": "deny"
  },
  "instructions": [
    "agents/*",
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "lsp": true,
  "provider": {
    "opencode": {
      "options": {
        "baseURL": "https://unroxy.koyeb.app/opencode.ai/zen/v1"
      },
      "blacklist": [
        "deepseek-v4-flash-free"
      ],
      "models": {
        "big-pickle": {
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "options": {
            "reasoningEffort": "max",
          },
        }
      }
    },
    "opendum": {
      "options": {
        "baseURL": "https://proxy.opendum.tech/v1"
      },
      "models": {
        "claude-opus-4-6": {
          "options": {
            "reasoningEffort": "high",
          },
        },
        "gpt-5.5": {
          "modalities": {
            "input": [
              "image",
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
          },
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh",
            }
          }
        },
      }
    },
    "command": {
      "options": {
        "baseURL": "https://cmd-proxy.up.railway.app/v1",
      },
      "models": {
        "deepseek/deepseek-v4-pro": {
          "options": {
            "reasoningEffort": "max",
          },
        },
      }
    },
    "gitlawb": {
      "options": {
        "baseURL": "https://opengateway.gitlawb.com/v1"
      },
      "models": {
        "mimo-v2.5-pro": {}
      }
    },
  },
}