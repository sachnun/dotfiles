{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "question": "deny"
  },
  "compaction": {
    "auto": false,
  },
  "lsp": true,
  "provider": {
    "opencode": {
      "options": {
        "baseURL": "https://unroxy.koyeb.app/opencode.ai/zen/v1"
      },
      "models": {
        "big-pickle": {
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "options": {
            "reasoningEffort": "max",
          },
        }
      }
    },
    "opendum": {
      "options": {
        "baseURL": "https://proxy.opendum.tech/v1"
      },
      "models": {
        "claude-opus-4-6": {
          "options": {
            "reasoningEffort": "high",
          },
        },
        "gpt-5.5": {
          "modalities": {
            "input": [
              "image",
            ],
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
          },
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh",
            }
          }
        },
      }
    },
    "command": {
      "options": {
        "baseURL": "https://cmd-proxy.up.railway.app/v1",
      },
      "models": {
        "moonshotai/Kimi-K2.6": {},
        "zai-org/GLM-5.1": {},
        "MiniMaxAI/MiniMax-M3": {},
        "deepseek/deepseek-v4-pro": {
          "options": {
            "reasoningEffort": "max",
          },
        },
        "Qwen/Qwen3.7-Max": {},
        "xiaomi/mimo-v2.5-pro": {},
      }
    },
  },
}