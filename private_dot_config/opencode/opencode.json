{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "websearch": "deny",
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "lsp": true,
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://unroxy.koyeb.app/mcp.exa.ai/mcp",
    }
  },
  "provider": {
    "opencode": {
      "options": {
        "baseURL": "https://unroxy.koyeb.app/opencode.ai/zen/v1"
      },
      "blacklist": [
        "deepseek-v4-flash-free"
      ],
      "models": {
        "big-pickle": {
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "options": {
            "reasoningEffort": "max",
          },
        }
      }
    },
    "opendum": {
      "options": {
        "baseURL": "https://proxy.opendum.tech/v1"
      },
      "models": {
        "claude-opus-4-6": {
          "options": {
            "reasoningEffort": "high",
          },
        },
        "gpt-5.5": {
          "modalities": {
            "input": [
              "image",
            ],
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
          },
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh",
            }
          }
        },
      }
    },
    "command": {
      "options": {
        "baseURL": "https://cmd-proxy.up.railway.app/v1",
      },
      "models": {
        "deepseek/deepseek-v4-pro": {
          "options": {
            "reasoningEffort": "max",
          },
        },
        "Qwen/Qwen3.7-Max": {},
        "Qwen/Qwen3.7-Max-Free": {},
      }
    },
  },
}