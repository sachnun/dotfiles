{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "question": "deny"
  },
  "compaction": {
    "prune": true,
    "reserved": 500
  },
  "lsp": true,
  "formatter": true,
  "small_model": "opencode/big-pickle",
  "plugin": [
    "@sachnun/command-opencode@latest",
  ],
  "provider": {
    "opencode": {
      "options": {
        // "baseURL": "https://unroxy.koyeb.app/opencode.ai/zen/v1"
      },
      "blacklist": [
        "opencode/deepseek-v4-flash-free"
      ],
      "models": {
        "big-pickle": {
          "name": "DeepSeek V4 Flash",
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "cost": {
            "input": 0.14,
            "output": 0.28,
            "cache_read": 0.0028
          },
          "variants": {
            "max": {
              "reasoningEffort": "max"
            }
          }
        }
      }
    },
    "freebux": {
      "name": "Freebux",
      "options": {
        "baseURL": "https://freebux-production.up.railway.app/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "id": "deepseek/deepseek-v4-flash",
          "name": "DeepSeek V4 Flash",
          "variants": {
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "deepseek-v4-pro": {
          "id": "deepseek/deepseek-v4-pro",
          "name": "DeepSeek V4 Pro",
          "variants": {
            "max": {
              "reasoningEffort": "max"
            }
          }
        },
        "mimo-v2.5": {
          "id": "mimo/mimo-v2.5",
          "name": "MiMo V2.5",
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "mimo-v2.5-pro": {
          "id": "mimo/mimo-v2.5-pro",
          "name": "MiMo V2.5 Pro",
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "minimax-m2.7": {
          "id": "minimax/minimax-m2.7",
          "name": "MiniMax M2.7",
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "minimax-m3": {
          "id": "minimax/minimax-m3",
          "name": "MiniMax M3",
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "kimi-k2.6": {
          "id": "moonshotai/kimi-k2.6",
          "name": "Kimi K2.6",
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    },
    "opendum": {
      "name": "Opendum",
      "options": {
        "baseURL": "https://proxy.opendum.tech/v1"
      },
      "models": {
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "gpt-5.5": {
          "name": "GPT 5.5",
          "modalities": {
            "input": [
              "image"
            ]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    }
  },
}