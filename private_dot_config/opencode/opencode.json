{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "external_directory": "allow",
        "question": "deny",
        "todowrite": "deny",
        "bash": {
            "git commit *": "ask",
            "git push *": "ask"
        }
    },
    "lsp": true,
    "formatter": true,
    "small_model": "opencode/big-pickle",
    "provider": {
        "opencode": {
            "options": {
                "baseURL": "https://unroxy.koyeb.app/opencode.ai/zen/v1"
            }
        },
        "freebux": {
            "name": "Freebux",
            "options": {
                "baseURL": "https://freebuxx.up.railway.app/v1"
            },
            "models": {
                "deepseek/deepseek-v4-pro": {
                    "name": "DeepSeek V4 Pro",
                    "variants": {
                        "max": {
                            "reasoningEffort": "max"
                        }
                    }
                },
                "moonshotai/kimi-k2.7-code": {
                    "name": "Kimi K2.7 Code",
                    "modalities": {
                        "input": ["image"]
                    }
                },
                "minimax/minimax-m3": {
                    "name": "Minimax M3",
                    "modalities": {
                        "input": ["image"]
                    }
                }
            }
        }
    }
}
