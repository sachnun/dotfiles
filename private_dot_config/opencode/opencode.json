{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow"
  },
  "lsp": true,
  "provider": {
    "opendum": {
      "name": "Opendum",
      "options": {
        "baseURL": "https://proxy.opendum.tech/v1"
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT 5.5",
          "modalities": {
            "input": [
              "image",
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high"
          },
          "variants": {
            "thinking": {
              "reasoningEffort": "xhigh",
              "serviceTier": "flex"
            }
          }
        },
        "claude-opus-4-6": {
          "name": "Opus 4.6",
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  }
}
