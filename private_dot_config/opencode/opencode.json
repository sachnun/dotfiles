{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "allow",
    "question": "deny",
    "todowrite": "deny",
    "task": "deny",
    "bash": {
      "git commit *": "ask",
      "git push *": "ask",
    },
  },
  "compaction": {
    "auto": false,
  },
  "lsp": true,
  "formatter": true,
  "small_model": "opencode/big-pickle",
  "plugin": [
    "@sachnun/command-opencode@latest",
  ],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    }
  },
  "provider": {
    "opencode": {
      "options": {
        "baseURL": "https://unroxy.koyeb.app/opencode.ai/zen/v1"
      },
    },
    "opendum": {
      "name": "Opendum",
      "options": {
        "baseURL": "https://proxy.opendum.tech/v1"
      },
      "models": {
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        },
        "gpt-5.5": {
          "name": "GPT 5.5",
          "modalities": {
            "input": [
              "image"
            ]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "variants": {
            "high": {
              "reasoningEffort": "high"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    }
  },
}