{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "allow",
    "question": "deny",
    "todowrite": "deny",
    "task": "deny",
    "bash": {
      "git commit *": "ask",
      "git push *": "ask",
    },
  },
  "lsp": true,
  "formatter": true,
  "small_model": "opencode/big-pickle",
  "plugin": [
    "@sachnun/command-opencode@latest",
  ],
  "provider": {
    "opencode": {
      "options": {
        "baseURL": "https://unroxy.koyeb.app/opencode.ai/zen/v1"
      },
    },
    "freebux": {
      "name": "Freebux",
      "options": {
        "baseURL": "https://freebux.up.railway.app/v1"
      },
      "models": {
        "minimax/minimax-m3": {
          "name": "Minimax M3",
          "limit": {
            "context": 1000000,
            "output": 512000
          }
        }
      }
    },
    "aerolink": {
      "name": "Aerolink",
      "npm": "@ai-sdk/anthropic",
      "options": {
        "baseURL": "https://capi.aerolink.lat/v1",
      },
      "models": {
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
        }
      }
    }
  },
}