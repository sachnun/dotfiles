{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "external_directory": "allow",
    "question": "deny",
    "todowrite": "deny",
    "task": "deny",
    "bash": {
      "git commit *": "ask",
      "git push *": "ask",
    },
  },
  "compaction": {
    "auto": false,
  },
  "lsp": true,
  "formatter": true,
  "small_model": "opencode/big-pickle",
  "plugin": [
    "@sachnun/command-opencode@latest",
  ],
  "provider": {
    "opencode": {
      "options": {
        "baseURL": "https://unroxy.koyeb.app/opencode.ai/zen/v1"
      },
    },
    "freebux": {
      "name": "Freebux",
      "options": {
        "baseURL": "https://freebux.up.railway.app/v1"
      },
      "models": {
        "mimo/mimo-v2.5-pro": {
          "name": "MiMo V2.5 Pro",
          "variants": {
            "high": {
              "reasoningEffort": "high"
            }
          }
        }
      }
    },
  },
}