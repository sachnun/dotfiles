{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "external_directory": "allow",
        "question": "deny",
        "todowrite": "deny",
        //"task": "deny",
        "bash": {
            "git commit *": "ask",
            "git push *": "ask"
        }
    },
    "lsp": true,
    "formatter": true,
    "small_model": "opencode/big-pickle",
    "plugin": [
        //"@sachnun/command-opencode"
    ],
    "provider": {
        "opencode": {
            "options": {
                "baseURL": "https://unroxy.koyeb.app/opencode.ai/zen/v1"
            }
        },
        "freebux": {
            "name": "Freebux",
            "options": {
                "baseURL": "https://freebuxx.up.railway.app/v1"
            },
            "models": {
                "deepseek/deepseek-v4-pro": {
                    "name": "DeepSeek V4 Pro",
                    "variants": {
                        "max": {
                            "reasoningEffort": "max"
                        }
                    }
                },
                "minimax/minimax-m3": {
                    "name": "Minimax M3",
                    "modalities": {
                        "input": ["image"]
                    }
                },
                "moonshotai/kimi-k2.6": {
                    "name": "Kimi K2.6",
                    "modalities": {
                        "input": ["image"]
                    }
                },
                "mimo/mimo-v2.5-pro": {
                    "name": "Mimo V2.5 Pro"
                }
            }
        }
    }
}
