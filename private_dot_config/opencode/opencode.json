{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow",
    "question": "deny"
  },
  "compaction": {
    "auto": false,
  },
  "lsp": true,
  "provider": {
    "opencode": {
      "options": {
        // "baseURL": "https://unroxy.koyeb.app/opencode.ai/zen/v1"
      },
      "models": {
        "big-pickle": {
          "limit": {
            "context": 1000000,
            "output": 384000
          },
          "options": {
            "reasoningEffort": "max",
          },
        }
      }
    },
    "opendum": {
      "name": "Opendum",
      "options": {
        "baseURL": "https://proxy.opendum.tech/v1"
      },
      "models": {
        "claude-opus-4-6": {
          "name": "Claude Opus 4.6",
          "options": {
            "reasoningEffort": "high",
          },
        },
        "gpt-5.5": {
          "name": "GPT 5.5",
          "modalities": {
            "input": [
              "image",
            ],
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
          },
          "variants": {
            "xhigh": {
              "reasoningEffort": "xhigh",
            }
          }
        },
      }
    },
  },
  "plugin": [
    "@sachnun/command-opencode@latest"
  ],
}
