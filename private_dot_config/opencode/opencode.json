{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "*": "allow"
  },
  "lsp": true,
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "mcp": {
    "exa": {
      "type": "remote",
      "url": "https://unroxy.koyeb.app/mcp.exa.ai/mcp",
      "enabled": true
    }
  },
  "provider": {
    "opencode": {
      "options": {
        "baseURL": "https://unroxy.koyeb.app/opencode.ai/zen/v1"
      },
    },
    "openbux": {
      "name": "Openbux",
      "options": {
        "baseURL": "https://openbux-production.up.railway.app/v1",
        "apiKey": "sk-zzz"
      },
      "models": {
        "moonshotai/kimi-k2.6": {
          "name": "Kimi 2.6",
          "options": {
            "reasoningEffort": "high",
          },
        },
        "deepseek/deepseek-v4-pro": {
          "name": "Deepseek V4 Pro",
          "options": {
            "reasoningEffort": "max",
          },
        },
      }
    },
    "opendum": {
      "name": "Opendum",
      "options": {
        "baseURL": "https://proxy.opendum.tech/v1"
      },
      "models": {
        "gpt-5.5": {
          "name": "GPT 5.5",
          "modalities": {
            "input": [
              "image",
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 272000,
            "output": 128000
          },
          "options": {
            "reasoningEffort": "high",
          },
          "variants": {
            "thinking": {
              "reasoningEffort": "xhigh",
            }
          }
        },
      }
    }
  }
}