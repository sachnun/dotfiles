{
  "lastChangelogVersion": "0.84.1",
  "defaultProvider": "opencode",
  "defaultModel": "deepseek-v4-flash-free",
  "hideThinkingBlock": true,
  "treeFilterMode": "default",
  "defaultThinkingLevel": "high",
  "theme": "dark",
  "packages": [
    "npm:pi-chrome"
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "extensions": [
    "-extensions/aihubmix.ts",
    "-extensions/restore.ts",
    "-extensions/bash.ts",
    "-extensions/checkpoint.ts",
    "+extensions/composio.ts"
  ],
  "quietStartup": false,
  "httpIdleTimeoutMs": 30000,
  "uiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "images": {
    "blockImages": true
  },
  "enableSkillCommands": false,
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "tuiMode": "fullscreen",
  "enabledModels": [
    "freebux/deepseek/deepseek-v4-flash",
    "opencode/deepseek-v4-flash-free"
  ],
  "retry": {
    "enabled": true,
    "maxRetries": 10,
    "baseDelayMs": 0
  }
}