{
  "lastChangelogVersion": "1.2.0",
  "hideThinkingBlock": true,
  "treeFilterMode": "default",
  "defaultThinkingLevel": "max",
  "theme": "dark",
  "packages": [
    "git:github.com/sachnun/pi-opendum"
  ],
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": false
  },
  "quietStartup": false,
  "httpIdleTimeoutMs": 300000,
  "uiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "images": {
    "blockImages": false
  },
  "enableSkillCommands": true,
  "showCacheMissNotices": true,
  "collapseChangelog": false,
  "tuiMode": "fullscreen",
  "steeringMode": "all",
  "markdown": {
    "mermaid": "streaming"
  },
  "enableInstallTelemetry": true,
  "fullscreenExitOutput": "resume-hint",
  "enabledModels": [
    "opendum/workbuddy/deepseek-v4.1-flash",
    "opendum/opencode/deepseek-v4.1-flash"
  ],
  "fullscreenCopyOnSelect": false,
  "fullscreenWheelScrollLines": "auto",
  "skills": [
    "-skills/kaggle/SKILL.md",
    "-skills/wsl.md"
  ],
  "defaultProvider": "opendum",
  "defaultModel": "workbuddy/deepseek-v4.1-flash",
  "extensions": [
    "-extensions/freebux.ts",
    "-extensions/loop.ts"
  ]
}