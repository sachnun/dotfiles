{
  "lastChangelogVersion": "1.0.0",
  "hideThinkingBlock": true,
  "treeFilterMode": "default",
  "defaultThinkingLevel": "max",
  "theme": "dark",
  "packages": [
    "git:github.com/sachnun/pi-opendum"
  ],
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": false
  },
  "extensions": [
    "-extensions/chrome/index.ts",
    "-extensions/telegram/index.ts",
    "-builtin:llama.cpp",
    "+builtin:mcp",
    "+builtin:tool-search"
  ],
  "quietStartup": false,
  "httpIdleTimeoutMs": 30000,
  "uiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "images": {
    "blockImages": false
  },
  "enableSkillCommands": true,
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "tuiMode": "fullscreen",
  "steeringMode": "all",
  "markdown": {
    "mermaid": "streaming"
  },
  "enableInstallTelemetry": true,
  "fullscreenExitOutput": "resume-hint",
  "showHardwareCursor": false,
  "defaultTools": [
    "+codemode"
  ],
  "enabledModels": [
    "freebux/deepseek/deepseek-v4-flash",
    "opendum/deepseek-v4.1-flash"
  ],
  "fullscreenCopyOnSelect": false,
  "fullscreenWheelScrollLines": "auto",
  "skills": [
    "-skills/kaggle/SKILL.md",
    "-skills/wsl.md"
  ],
  "defaultProvider": "opendum",
  "defaultModel": "deepseek-v4.1-flash"
}