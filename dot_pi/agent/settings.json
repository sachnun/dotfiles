{
  "lastChangelogVersion": "0.84.0",
  "defaultProvider": "opencode",
  "defaultModel": "deepseek-v4-flash-free",
  "hideThinkingBlock": true,
  "treeFilterMode": "default",
  "defaultThinkingLevel": "high",
  "theme": "dark",
  "packages": [
    {
      "source": "npm:@llblab/pi-telegram",
      "extensions": [
        "-index.ts"
      ]
    }
  ],
  "terminal": {
    "showTerminalProgress": true
  },
  "extensions": [
    "-extensions/aihubmix.ts",
    "-extensions/restore.ts",
    "-extensions/bash.ts",
    "-extensions/checkpoint.ts"
  ],
  "quietStartup": false,
  "httpIdleTimeoutMs": 30000,
  "uiMode": "fullscreen",
  "fullscreenScrollbar": "auto",
  "images": {
    "blockImages": true
  },
  "enableSkillCommands": false,
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "tuiMode": "fullscreen",
  "enabledModels": [
    "opencode/deepseek-v4-flash-free",
    "freebux/deepseek/deepseek-v4-flash"
  ],
  "retry": {
     "enabled": true,
     "maxRetries": 10,
     "baseDelayMs": 0
   }
}
