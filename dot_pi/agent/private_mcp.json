{
  "mcpServers": {
    "agent-browser": {
      "command": "npx",
      "args": [
        "agent-browser",
        "mcp"
      ]
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CLOUDFLARE_API_TOKEN}"
      }
    },
    "colab": {
      "url": "https://colab-bridge.primare.workers.dev/mcp",
      "oauth": {
        "authServerMetadataUrl": "https://colab-bridge.primare.workers.dev/oauth/authorization-server-metadata"
      }
    },
    "koyeb": {
      "command": "npx",
      "args": [
        "@koyeb/mcp-server"
      ]
    },
    "executor": {
      "url": "https://mcp.executor.sh/mcp",
      "exposure": "direct"
    }
  }
}
