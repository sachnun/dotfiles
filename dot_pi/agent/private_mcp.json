{
  "mcpServers": {
    "agent-browser": {
      "command": "npx",
      "args": [
        "agent-browser",
        "mcp"
      ]
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer ${CLOUDFLARE_API_TOKEN}"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "kaggle": {
      "url": "https://www.kaggle.com/mcp",
      "oauth": {
        "clientId": "pi-mcp-kaggle-87d62ca9",
        "callbackPort": 8765
      }
    },
    "neon": {
      "url": "https://mcp.neon.tech/mcp"
    },
    "turso": {
      "url": "https://mcp.turso.ai/mcp"
    },
    "colab": {
      "url": "https://colab-bridge.sachnun.workers.dev/mcp",
      "oauth": {
        "authServerMetadataUrl": "https://colab-bridge.sachnun.workers.dev/oauth/authorization-server-metadata"
      }
    },
    "railway": {
      "url": "https://mcp.railway.com",
      "enabled": false
    },
    "koyeb": {
      "command": "npx",
      "args": [
        "@koyeb/mcp-server"
      ]
    },
    "netlify": {
      "url": "https://netlify-mcp.netlify.app/mcp"
    },
    "edgeone": {
      "url": "https://edgeone-bridge.sachnun.workers.dev/mcp"
    },
    "rea": {
      "command": "npx",
      "args": [
        "rea-agents",
        "mcp"
      ]
    },
    "parallel": {
      "url": "https://search.parallel.ai/mcp-oauth"
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa"
    }
  }
}
