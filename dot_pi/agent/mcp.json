{
  "mcpServers": {
    "cua-driver": {
      "command": "cua-driver",
      "args": ["mcp"],
      "env": {
        "CUA_DRIVER_PERMISSION_MODE": "standard"
      },
      "exposure": "codemode-deferred"
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp"
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp",
      "exposure": "codemode-deferred"
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "exposure": "codemode-deferred"
    }
  }
}
