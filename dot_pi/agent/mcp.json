{
  "mcpServers": {
    "agent-browser": {
      "command": "npx",
      "args": [
        "agent-browser",
        "mcp"
      ]
    },
    "cua-driver": {
      "command": "cua-driver",
      "args": [
        "mcp"
      ],
      "env": {
        "CUA_DRIVER_PERMISSION_MODE": "standard"
      }
    },
    "exa": {
      "url": "https://mcp.exa.ai/mcp",
      "description": "Neural web search and page fetching"
    },
    "cloudflare": {
      "url": "https://mcp.cloudflare.com/mcp",
      "description": "Cloudflare docs search and Workers API execution",
      "headers": {
        "Authorization": "Bearer ${CLOUDFLARE_API_TOKEN}"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "kaggle": {
      "url": "https://www.kaggle.com/mcp",
      "description": "Kaggle datasets, competitions, notebooks and models",
      "oauth": {
        "clientId": "pi-mcp-kaggle-87d62ca9",
        "callbackPort": 8765
      }
    },
    "neon": {
      "url": "https://mcp.neon.tech/mcp",
      "description": "Neon Postgres projects, branches, databases and SQL"
    },
    "turso": {
      "url": "https://mcp.turso.ai/mcp",
      "description": "Turso/libSQL databases, groups and SQL"
    },
    "colab": {
      "url": "https://colab-bridge.sachnun.workers.dev/mcp",
      "description": "Run Python, shell commands and manage files on Google Colab VMs",
      "oauth": {
        "authServerMetadataUrl": "https://colab-bridge.sachnun.workers.dev/oauth/authorization-server-metadata"
      }
    },
    "railway": {
      "url": "https://mcp.railway.com"
    }
  }
}
