{{- if eq .chezmoi.os "linux" -}}
#!{{ lookPath "bash" }}
# Mise config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}
set -euo pipefail

INSTALL_DIR="$HOME/.local/bin"
mkdir -p "$INSTALL_DIR"

export PATH="$HOME/.local/share/mise/shims:$INSTALL_DIR:$PATH"

MISE_BIN="$(command -v mise || true)"
if [ -z "$MISE_BIN" ]; then
  curl -fsSL https://mise.run | sh
  MISE_BIN="$INSTALL_DIR/mise"
fi
if [ ! -x "$MISE_BIN" ]; then
  echo "ERROR: mise not found after install." >&2
  exit 1
fi

cd "$HOME"
"$MISE_BIN" bootstrap --yes --update

"$MISE_BIN" bootstrap packages prune --manager brew --yes

"$MISE_BIN" prune --yes
{{ end -}}
