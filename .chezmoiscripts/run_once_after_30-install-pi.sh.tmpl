#!/bin/bash
set -euo pipefail

# pi (https://pi.dev) — terminal coding harness.
# Installed via the official installer, which auto-detects the platform,
# Node.js/npm availability, TTY, and npm prefix.

if command -v pi >/dev/null 2>&1; then
  echo "pi already installed: $(command -v pi)"
  exit 0
fi

echo "Installing pi (pi.dev)..."
curl -fsSL https://pi.dev/install.sh | sh
