{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "android") -}}
#!{{ lookPath "bash" }}
# Packages hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
set -euo pipefail

{{- if and (hasKey .chezmoi.osRelease "id") (or (eq .chezmoi.osRelease.id "arch") (eq .chezmoi.osRelease.id "archlinux")) }}
packages=(
{{- range .packages.pacman }}
    {{ . }}
{{- end }}
)
pacman -Syu --needed --noconfirm "${packages[@]}"
{{- else if and (hasKey .chezmoi.osRelease "id") (or (eq .chezmoi.osRelease.id "debian") (eq .chezmoi.osRelease.id "ubuntu")) }}
# Debian / Ubuntu — use apt
if [ "$(id -u)" -eq 0 ]; then
  SUDO=""
else
  SUDO="sudo"
fi
apt_packages=(
{{- range .packages.apt }}
    {{ . }}
{{- end }}
)
export DEBIAN_FRONTEND=noninteractive
${SUDO} apt-get update
${SUDO} apt-get install -y "${apt_packages[@]}"

# Latest Node.js via the NodeSource apt repo — Debian's nodejs is too old for pi (needs >= v20).
if command -v node >/dev/null 2>&1 && [ "$(node -v | sed 's/[v.]/ /g' | awk '{print $1}')" -ge 20 ]; then
  echo "Node.js >= v20 already installed: $(node -v)"
else
  echo "Installing latest Node.js via NodeSource apt repo..."
  curl -fsSL https://deb.nodesource.com/setup_current.x | ${SUDO:-} bash -
  ${SUDO:-} apt-get install -y nodejs
fi

# glab is not in official Debian/Ubuntu repos — install the official .deb from GitLab releases.
if ! command -v glab >/dev/null 2>&1; then
  echo "Installing glab from GitLab releases..."
  glab_arch="$(dpkg --print-architecture 2>/dev/null || echo amd64)"
  case "$glab_arch" in
    amd64|arm64) ;;
    *) echo "Skipping glab: unsupported architecture $glab_arch"; exit 0 ;;
  esac
  glab_version="$(curl -fsSL 'https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/releases/permalink/latest' | grep -o '"tag_name":"[^"]*"' | head -1 | cut -d'"' -f4 | tr -d 'v')"
  glab_deb="$(mktemp --suffix=.deb)"
  curl -fsSL "https://gitlab.com/api/v4/projects/gitlab-org%2Fcli/packages/generic/glab/${glab_version}/glab_${glab_version}_linux_${glab_arch}.deb" -o "$glab_deb"
  ${SUDO} dpkg -i "$glab_deb" || ${SUDO} apt-get -f install -y
  rm -f "$glab_deb"
fi
{{- else if not (hasKey .chezmoi.osRelease "id") }}
# Termux / Android — use pkg
termux_packages=(
{{- range .packages.pkg }}
    {{ . }}
{{- end }}
)
pkg update
pkg upgrade -y
pkg install -y "${termux_packages[@]}"
{{- end }}
{{ end -}}
