{{- if eq .chezmoi.os "linux" -}}
#!{{ lookPath "bash" }}
set -euo pipefail

# fastfetch: installed from the latest GitHub release .deb because distro
# packages are often outdated. Skipped if already installed.

if command -v fastfetch >/dev/null 2>&1; then
  exit 0
fi

if ! grep -qiE 'debian|ubuntu' /etc/os-release 2>/dev/null; then
  echo "fastfetch: no .deb install path for this distro; skipping."
  exit 0
fi

case "$(uname -m)" in
  x86_64|amd64) deb_arch=amd64 ;;
  aarch64|arm64) deb_arch=aarch64 ;;
  *) deb_arch="" ;;
esac

if [ -z "$deb_arch" ]; then
  echo "fastfetch: unsupported architecture ($(uname -m)); skipping."
  exit 0
fi

deb_url="$(curl -fsSL https://api.github.com/repos/fastfetch-cli/fastfetch/releases/latest | jq -r '.assets[].browser_download_url' | grep -E "linux-${deb_arch}\.deb$" | head -n1)"
if [ -z "$deb_url" ]; then
  echo "fastfetch: no .deb asset found for linux-${deb_arch}; skipping."
  exit 0
fi

curl -fsSL -o /tmp/fastfetch.deb "$deb_url"
if [ "$(id -u)" -eq 0 ]; then
  dpkg -i /tmp/fastfetch.deb
else
  sudo dpkg -i /tmp/fastfetch.deb
fi
rm -f /tmp/fastfetch.deb
{{ end -}}
