{{- if eq .chezmoi.os "linux" -}}
#!{{ lookPath "bash" }}
# Packages hash: {{ include ".chezmoidata/packages.yaml" | sha256sum }}
set -euo pipefail

{{- if or (eq .chezmoi.osRelease.id "arch") (eq .chezmoi.osRelease.id "archlinux") }}
packages=(
{{- range .packages.pacman }}
    {{ . }}
{{- end }}
)
pacman -Sy --needed --noconfirm "${packages[@]}"
{{- else if not (hasKey .chezmoi.osRelease "id") }}
# Termux / Android — use pkg
termux_packages=(
{{- range .packages.pkg }}
    {{ . }}
{{- end }}
)
pkg update
pkg install -y "${termux_packages[@]}"
{{- end }}
{{ end -}}
