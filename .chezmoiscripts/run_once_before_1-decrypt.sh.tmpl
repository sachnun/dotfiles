{{- if eq .chezmoi.os "linux" -}}
#!{{ lookPath "sh" }}
set -eu

key_path="$HOME/.config/chezmoi/key.txt"

[ -f "$key_path" ] && exit 0

# Locate chezmoi; it may be installed outside PATH (e.g. GitHub Codespaces).
chezmoi_bin=""
for candidate in "$(command -v chezmoi 2>/dev/null || true)" \
  "$HOME/.local/bin/chezmoi" "$HOME/bin/chezmoi" "/usr/local/bin/chezmoi" \
  "$PWD/.local/bin/chezmoi" /workspaces/*/.local/bin/chezmoi; do
  if [ -n "$candidate" ] && [ -x "$candidate" ]; then
    chezmoi_bin="$candidate"
    break
  fi
done

if [ -z "$chezmoi_bin" ]; then
  echo "chezmoi not found, skipping age key decryption."
  exit 0
fi

mkdir -p "$HOME/.config/chezmoi"
src_key="{{ .chezmoi.sourceDir }}/key.txt.age"
"$chezmoi_bin" age decrypt --output "$key_path" --passphrase "$src_key"
chmod 600 "$key_path"
{{ end -}}