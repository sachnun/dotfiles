{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "android") -}}
#!{{ lookPath "bash" }}
# Tools hash: {{ include ".chezmoidata/tools.yaml" | sha256sum }}
set -euo pipefail

# Tools not reliably available in distro package repositories.
# Every install is guarded by `command -v`; already-installed tools are skipped.

INSTALL_DIR="$HOME/.local/bin"
mkdir -p "$INSTALL_DIR"

{{- range .tools }}
{{- if or (eq $.chezmoi.os "linux") (not (index . "exclude_android")) }}
if ! command -v {{ .name }} >/dev/null 2>&1; then
  echo "Installing {{ .name }}..."
  {{ .install }}
fi
{{- end }}
{{- end }}
{{ end -}}
