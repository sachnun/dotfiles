{{- if eq .chezmoi.os "linux" -}}
#!{{ lookPath "bash" }}
set -euo pipefail

# Set fish as the login shell (chsh). On Termux/Android the login shell
# stays bash and fish is launched from the chezmoi-managed ~/.bashrc, so
# no chsh equivalent is needed there.

if ! command -v fish >/dev/null 2>&1; then
  echo "Skipping default shell change: fish is unavailable."
  exit 0
fi

if [ ! -t 0 ]; then
  echo "Skipping default shell change: no interactive TTY."
  exit 0
fi

fish_path="$(command -v fish)"
current_shell="${SHELL:-}"

if ! command -v chsh >/dev/null 2>&1; then
  echo "Skipping default shell change: chsh is unavailable."
  exit 0
fi
if [ "$current_shell" != "$fish_path" ]; then
  if command -v sudo >/dev/null 2>&1 && sudo -n true 2>/dev/null; then
    sudo chsh -s "$fish_path"
  else
    chsh -s "$fish_path"
  fi
fi
{{ end -}}
