{{- if eq .chezmoi.os "linux" -}}
#!{{ lookPath "bash" }}
set -euo pipefail

# Set fish as the login shell (chsh).

if ! command -v fish >/dev/null 2>&1; then
  echo "Skipping default shell change: fish is unavailable."
  exit 0
fi

fish_path="$(command -v fish)"
current_shell="${SHELL:-}"

if ! command -v chsh >/dev/null 2>&1; then
  echo "Skipping default shell change: chsh is unavailable."
  exit 0
fi
if [ "$current_shell" != "$fish_path" ]; then
  if command -v sudo >/dev/null 2>&1; then
    # Must pass the username explicitly: under sudo, chsh without a username
    # changes root's shell instead of the current user's.
    sudo chsh -s "$fish_path" "$(id -un)"
  elif [ -t 0 ]; then
    # Interactive chsh; will prompt for the password.
    chsh -s "$fish_path"
  else
    echo "Skipping default shell change: no sudo and no interactive TTY."
    exit 0
  fi
fi
{{ end -}}
