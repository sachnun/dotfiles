{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -euo pipefail

if [ "${CODESPACES:-false}" = "true" ]; then
  echo "Skipping default shell change in GitHub Codespaces."
  exit 0
fi

if ! command -v fish >/dev/null 2>&1; then
  echo "Skipping default shell change: fish is unavailable."
  exit 0
fi

if [ ! -t 0 ]; then
  echo "Skipping default shell change: no interactive TTY."
  exit 0
fi

fish_path="$(command -v fish)"
current_shell="${SHELL:-}"

{{- if hasKey .chezmoi.osRelease "id" }}
# Standard Linux — use chsh
if ! command -v chsh >/dev/null 2>&1; then
  echo "Skipping default shell change: chsh is unavailable."
  exit 0
fi
if [ "$current_shell" != "$fish_path" ]; then
  chsh -s "$fish_path"
fi
{{- else }}
# Termux / Android — no chsh; auto-launch fish from .bashrc
if [ "$current_shell" != "$fish_path" ]; then
  cat >> "$HOME/.bashrc" << 'EOF'
# Start fish on login (set by chezmoi)
if [ -x "$(command -v fish)" ] && [ "$(ps -p $$ -o comm= 2>/dev/null)" != "fish" ]; then
  exec fish
fi
EOF
  echo "Added fish auto-launch to ~/.bashrc"
fi
{{- end }}
{{ end -}}
