{{- if or (eq .chezmoi.os "linux") (eq .chezmoi.os "android") -}}
#!{{ lookPath "sh" }}
set -eu

export PATH="$HOME/.local/bin:$HOME/bin:${PREFIX:-/usr}/bin:$PATH"

# Ensure chezmoi is available
if ! command -v chezmoi >/dev/null 2>&1; then
  echo "chezmoi not found, skipping age key decryption."
  exit 0
fi

key_path="$HOME/.config/chezmoi/key.txt"

if [ -f "$key_path" ]; then
  exit 0
fi

mkdir -p "$HOME/.config/chezmoi"
src_key="{{ .chezmoi.sourceDir }}/key.txt.age"

if [ -n "${CHEZMOI_PASSPHRASE:-}" ] && command -v expect >/dev/null 2>&1; then
  # Non-interactive: feed passphrase from the CHEZMOI_PASSPHRASE env var.
  # The passphrase is read inside expect via $env() to avoid shell quoting issues.
  expect -c "
    set timeout 60
    spawn chezmoi age decrypt --output $key_path --passphrase $src_key
    expect -re {[Pp]assphrase}
    send \"\$env(CHEZMOI_PASSPHRASE)\\r\"
    expect eof
  " >/dev/null
else
  chezmoi age decrypt --output "$key_path" --passphrase "$src_key"
fi
chmod 600 "$key_path"
{{ end -}}
