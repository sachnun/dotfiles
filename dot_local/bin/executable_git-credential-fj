#!/bin/sh
set -e

keys="${FJ_KEYS:-$HOME/.local/share/forgejo-cli/keys.json}"
action="$1"

[ -r "$keys" ] || exit 0
[ "$action" = "get" ] || exit 0

host=
while IFS= read -r line; do
  [ -n "$line" ] || break
  case "$line" in
    host=*) host="${line#host=}" ;;
  esac
done

[ -n "$host" ] || exit 0

read_token() {
  if command -v jq >/dev/null 2>&1; then
    jq -r --arg host "$host" '.hosts[$host].token // empty' "$keys"
  else
    python3 - "$keys" "$host" <<'PY'
import json, sys
data = json.load(open(sys.argv[1]))
print(data.get("hosts", {}).get(sys.argv[2], {}).get("token", ""))
PY
  fi
}

token=$(read_token)
[ -n "$token" ] || exit 0

printf 'username=token\npassword=%s\n' "$token"
