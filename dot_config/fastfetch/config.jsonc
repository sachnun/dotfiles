{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "none"
  },
  "display": {
    "brightColor": false,
    "separator": " ",
    "disableLinewrap": true,
    "color": {
      "keys": "cyan"
    }
  },
  "modules": [
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "memory",
    "disk",
    "battery"
  ]
}
