{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "brightColor": false,
    "separator": " ",
    "disableLinewrap": true,
    "color": {
      "keys": "cyan"
    }
  },
  "logo": {
    "type": "auto",
    "printRemaining": false,
    "padding": {
      "top": 0,
      "right": 2
    }
  },
  "modules": [
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "terminal",
    "cpu",
    "memory",
    "disk",
    "battery"
  ]
}
